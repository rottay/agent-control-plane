{
  "name": "@acp/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rottay Agent Control Plane — provider-neutral local control plane. P0 bootstrap and authority.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.17.0 <23",
    "pnpm": ">=10.26.2"
  },
  "scripts": {
    "check": "pnpm run check:architecture && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --build --force tsconfig.base.json",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest watch",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.2",
    "eslint": "9.39.1",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
