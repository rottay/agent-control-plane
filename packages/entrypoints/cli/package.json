{
  "name": "@acp/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Observation CLI for the Agent Control Plane. Every read verb opens the ledger query-only; exactly one named verb, tool-call, opens a short-lived writable handle and appends one receipt through the shared operation.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "acp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@acp/accounts": "workspace:*",
    "@acp/protocol": "workspace:*",
    "@acp/ledger": "workspace:*",
    "@acp/runtime": "workspace:*",
    "@acp/tools": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
}
