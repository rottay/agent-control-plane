{
  "name": "@acp/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supervised local daemon for the Agent Control Plane. Owns process lifecycle, singleton, bounded logs and a redacted status observation over the runtime durability plane.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "acp-daemon": "./dist/bin/acp-daemon/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && node -e \"const f='dist/bin/acp-daemon/index.js',fs=require('fs');const s=fs.readFileSync(f,'utf8').split('\\n');s[0]='#!'+process.execPath;fs.writeFileSync(f,s.join('\\n'));fs.chmodSync(f,0o755)\""
  },
  "dependencies": {
    "@acp/contracts": "workspace:*",
    "@acp/durability": "workspace:*",
    "@acp/ledger": "workspace:*",
    "@acp/providers": "workspace:*",
    "@acp/runtime": "workspace:*"
  },
  "devDependencies": {
    "@acp/accounts": "workspace:*",
    "vitest": "3.2.4"
  }
}
