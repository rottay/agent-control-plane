# Agent Control Plane — deterministic, offline-safe install policy.
# No postinstall scripts (P0 law: no arbitrary code at install time).
enable-pre-post-scripts=false
ignore-scripts=true

# Deterministic resolution.
engine-strict=true
save-exact=true
resolution-mode=highest
prefer-workspace-packages=true
link-workspace-packages=true

# No telemetry, no funding noise, no interactive prompts in CI.
fund=false
update-notifier=false

# Peer dependency strictness keeps the graph honest.
strict-peer-dependencies=false
auto-install-peers=true
